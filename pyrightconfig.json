{
    "include": [
        "uni_robot_agent",
        "scripts"
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        ".git",
        "build",
        "dist",
        ".pytest_cache",
        ".ruff_cache",
        "eval_outputs"
    ],
    "extraPaths": [
        "."
    ],
    "pythonVersion": "3.11",
    "pythonPlatform": "Linux",
    "typeCheckingMode": "basic",
    "useLibraryCodeForTypes": true,
    "reportMissingImports": true,
    "reportMissingTypeStubs": false
}
